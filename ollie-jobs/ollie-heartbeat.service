[Unit]
Description=Ollie heartbeat (one beat of the inner loop)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /home/openclaw/bin/ollie_heartbeat.py
Environment=HOME=/home/openclaw
Environment=PATH=/home/openclaw/.openclaw/tools/node-v22.22.0/bin:/home/openclaw/.local/bin:/home/openclaw/bin:/usr/local/bin:/usr/bin:/bin
